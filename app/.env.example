# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). Never commit the real .env file.
#
# For a local fake barn (screenshots), do not replace this file. Copy
# env.local-supabase.example to .env.development.local instead — see
# docs/local-demo.md. That keeps live keys in .env untouched.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
